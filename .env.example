# Copy this file to .env and fill in the two real values below (ask
# the CAMELS team for the current private-webspace URLs) - .env
# itself is gitignored, so the real values never get committed.
#
# Both gate real backend.py features (get_field_map_2d / 3D density-field
# grids) - without them set, those features cleanly return "no data"
# (None) rather than crashing, same honesty as every other real-data-only
# function in backend.py.
CAMELS_CMD_3D_GRIDS_URL=<ask-the-camels-team-for-this-url>
CAMELS_CMD_2D_MAPS_URL=<ask-the-camels-team-for-this-url>
