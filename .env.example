# Copy this file to .env - the two real values below are the CAMELS
# team's own public CMD (CAMELS Multifield Dataset) webspace URLs,
# published at https://camels-multifield-dataset.readthedocs.io/en/latest/access.html
# - .env itself is gitignored, so any local overrides never get committed.
#
# Both gate real backend.py features (get_field_map_2d / 3D density-field
# grids) - without them set, those features cleanly return "no data"
# (None) rather than crashing, same honesty as every other real-data-only
# function in backend.py.
CAMELS_CMD_3D_GRIDS_URL=https://users.flatironinstitute.org/~fvillaescusa/priv/DEPnzxoWlaTQ6CjrXqsm0vYi8L7Jy/CMD/3D_grids/data
CAMELS_CMD_2D_MAPS_URL=https://users.flatironinstitute.org/~fvillaescusa/priv/DEPnzxoWlaTQ6CjrXqsm0vYi8L7Jy/CMD/2D_maps/data
